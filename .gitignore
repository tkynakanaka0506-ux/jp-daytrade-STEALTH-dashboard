# 依存パッケージ
node_modules/

# 生成物のうち、CI(GitHub Actions)が実行間で状態を引き継ぐ必要がないもの
# （index.html本体と各daily cacheはGitHub Pages配信・次回実行の差分計算に必須なので追跡する）
stock_results.json
tdnet_filtered_results.json

# ローカル専用の許可設定（マシンごとに違うのでバージョン管理しない）
.claude/settings.local.json

# APIキー・トークン等の秘密情報（絶対にコミットしない）
.env
.env.*

# macOS
.DS_Store

# 多重起動防止ロック
.scraper.lock
